# Copy to backend/.env (gitignored) and fill in. Real environment variables take precedence over this file.

# Required: PostgreSQL password for the app's database user.
DB_PASSWORD=change-me

# Required: HS256 signing key for admin JWTs, at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional: password for the seeded admin (admin@tracker.local). Only used the first time the database is seeded.
# If left unset, a random password is generated and printed once in the startup log.
# SEED_ADMIN_PASSWORD=

# Optional overrides
# DB_URL=jdbc:postgresql://localhost:5432/egov_tracker
# DB_USER=egov
# CORS_ORIGINS=http://localhost:5173
# SEED_ENABLED=true
